  {
   "kind": 2,
   "value": "StringToBits[word_String] := IntegerDigits[ToCharacterCode[word], 2, 8];\nBitsToHex[bits_List] := StringJoin[\n  IntegerString[FromDigits[#, 2], 16, 1] & /@ Partition[bits, 4]\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1786463286940,
     "endTime": 1786463287065
    },
    "executionOrder": 1412,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "Adjust[lista_List, n_Integer, m_Integer] := \n  Flatten[Riffle[Partition[lista, n, n, 1, {}], {ConstantArray[0, m]}]];\n\nHashFun[word_String, nBits_Integer] := Module[{bits, bitsAd, acc},\n  bits = StringToBits[word];\n  bitsAd = Adjust[#, 1, Round[nBits/8]] & /@ bits;\n  \n  (* Usiamo bits[[i]] originale per lo shift e la lunghezza effettiva del vettore per la rotazione *)\n  acc = Fold[\n    RotateLeft[#1 + #2, Mod[15 + FromDigits[#2, 2], Length[#1]]] &, \n    bitsAd[[1]], \n    Rest[bitsAd]\n  ];\n\n  Mod[acc, 2]\n]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1786463287065,
     "endTime": 1786463287191
    },
    "executionOrder": 1414,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "nBits = 4*16;\nBitsToHex[HashFun[\"a\", nBits]]\nBitsToHex[HashFun[\"aa\", nBits]]\nBitsToHex[HashFun[\"aaa\", nBits]]\nBitsToHex[HashFun[\"aaaa\", nBits]]\nBitsToHex[HashFun[\"aaaaa\", nBits]]\nBitsToHex[HashFun[\"aaaaaa\", nBits]]\nBitsToHex[HashFun[\"abcdbendeidjedenidiededied\", nBits]]",
   "languageId": "wolfram",
   "outputs": [
