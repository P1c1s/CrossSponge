{
 "cells": [
  {
   "kind": 2,
   "value": "(* ClearAll[\"Global`*\"]\ncharacters = Partition[FromCharacterCode /@ Range[97, 122], 1];\nwords = Permutations[characters, 2];\nwords = Rest[StringJoin /@ words];\nLength[words] *)\n\nClearAll[\"Global`*\"]\n\nGeneraParole[mChars_Integer, nWords_Integer] := Table[StringJoin[RandomChoice[CharacterRange[\"a\", \"z\"], mChars]], nWords];\nwords = GeneraParole[120, 5000];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1786463286388,
     "endTime": 1786463286812
    },
