 "cells": [
  {
   "kind": 2,
   "value": "RandomBits[n_Integer] := RandomInteger[{0,1},n];\n\nkeys = {k1, k2, k3, k4, k5, k6, k7, k8};\nivs = {v1, v2, v3, v4, v5, v6, v7, v8};\n\nkey = RandomBits[Length[keys]]\niv = RandomBits[Length[ivs]]\n\nword = StringToBits[\"a\"]",
   "languageId": "wolfram",
   "outputs": [
