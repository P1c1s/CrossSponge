 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n\nRandomBits[n_Integer] := RandomInteger[{0,1},n];\n\nkeyS = {k1, k2, k3, k4, k5, k6, k7, k8};\nivS = {v1, v2, v3, v4, v5, v6, v7, v8};\n\nkey = RandomBits[Length[keyS]]\niv = RandomBits[Length[ivS]]\n\nword = StringToBits[\"d\"]\nmatrixS = {{a,b,c,d},{e,f,g,h},{i,l,m,n},{o,p,q,r}};\nwordS = {k,k,k,k,k,k,k,k};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Struct[key_List, iv_List] := Partition[Join[key, iv], Sqrt[Length[Join[key,iv]]]];\n\nStringToBits[str_String] := Flatten[IntegerDigits[ToCharacterCode[str], 2, 8]];\n\nBitsToString[bits_List] := FromCharacterCode[FromDigits[#, 2] & /@ Partition[bits, 8]];\n\nSubstitutionLayer[state_List] := Module[\n  {len, half, qTL, qTR, qBL, qBR, nTL, nTR, nBL, nBR},\n  \n  len = Length[state];\n  half = len / 2;\n\n  (* 1. Estrazione dei 4 quadranti originali *)\n  qTL = state[[1 ;; half, 1 ;; half]];\n  qTR = state[[1 ;; half, half + 1 ;; len]];\n  qBL = state[[half + 1 ;; len, 1 ;; half]];\n  qBR = state[[half + 1 ;; len, half + 1 ;; len]];\n  AC = Array[Mod[#1 + #2, 2] &, {half, half}]; (* Costante Affine *)\n\n  (* 2. Calcolo dei nuovi quadranti con incrocio *)\n  nTL = PolynomialMod[qTL + qTL * qBR + AC, 2];\n  nTR = PolynomialMod[qTR + qTR * qBL + AC, 2];\n  nBL = PolynomialMod[qBL + qBL * qTR + AC, 2];\n  nBR = PolynomialMod[qBR + qBR * qTL + AC, 2];\n\n  (* 3. Ricostruzione della matrice quadrata N x N originale *)\n  ArrayFlatten[{{nTL, nTR}, {nBL, nBR}}]\n]\n\nDiffiusionLayer[state_List] := Module[\n    {row1, row2, row3, row4, col1, col2, col3, col4, len},\n    \n    len = Length[state];\n    {row1, row2, row3, row4} = state;\n\n    \n    row1 = RotateLeft[row1, 1]; \n    row2 = RotateLeft[row2, 2];\n    row3 = RotateLeft[row3, 3];\n    row4 = RotateLeft[row4, 4];\n\n    (* Rotazioni verticali *)\n    {col1, col2, col3, col4} = Transpose[{row1, row2, row3, row4}];  \n    {RotateLeft[col1, len / 2], \n     RotateLeft[col2, len / 2],\n     RotateLeft[col3, len / 2],\n     RotateLeft[col4, len / 2]\n    }\n\n];\n\nn = 4;\nf[word_String] := Partition[StringToBits[word], n];\n\nSpongeAbsorption[state_List, word_String] := PolynomialMod[state[[1]] + f[word], 2]\n\nCrossRound[state_List] := DiffiusionLayer[SubstitutionLayer[state]];\n\nCrossSpongeWarmUp[key_List, iv_List, nRound_Integer] := Nest[CrossRound[#] &, Struct[key, iv], nRound];\n\nCrossSpongeEnc[key_List, iv_List, nRound_Integer, word_List] := Module[\n  {initState, absorbedState, cipherBits, nextState},\n  initState = CrossSpongeWarmUp[key, iv, nRound];\n  absorbedState = SpongeAbsorption[initState, word];\n  cipherBits = CipherMask[absorbedState];\n  nextState = CrossRound[absorbedState];\n  cipherBits\n];\n\nCrossSpongeEncString[key_List, iv_List, nWarmRounds_Integer, str_String] := Module[\n  {\n    blocks = Partition[StringToBits[str], 8], (* Divide la stringa in blocchi da 8 bit *)\n    state = CrossSpongeWarmUp[key, iv, nWarmRounds],\n    absorbedState,\n    cipherBlocks = {}\n  },\n  \n  Do[\n    (* 1. Assorbimento del blocco corrente *)\n    absorbedState = SpongeAbsorption[state, block];\n    \n    (* 2. Estrazione degli 8 bit cifrati *)\n    AppendTo[cipherBlocks, CipherMask[absorbedState]];\n    \n    (* 3. Permutazione per preparare lo stato al blocco successivo *)\n    state = CrossRound[absorbedState];\n    \n  , {block, blocks}];\n  \n  (* Restituisce la lista di tutti i bit cifrati *)\n  Flatten[cipherBlocks]\n]\n\n(* CrossSpongeWarmUp[keys, ivs, 1] //MatrixForm\nCrossSpongeWarmUp[keys, ivs, 2] //MatrixForm\nCrossSpongeWarmUp[keys, ivs, 3] //MatrixForm *)\n\n(* \nCrossSpongeWarmUp[key, iv, 1] //MatrixForm\nCrossSpongeWarmUp[key, iv, 2] //MatrixForm\nCrossSpongeWarmUp[key, iv, 3] //MatrixForm\nCrossSpongeWarmUp[key, iv, 4] //MatrixForm\nCrossSpongeWarmUp[key, iv, 5] //MatrixForm\nCrossSpongeWarmUp[key, iv, 6] //MatrixForm\nCrossSpongeWarmUp[key, iv, 7] //MatrixForm *)\n(* \nPrint[\"Stato iniziale\"]\nstate = CrossSpongeWarmUp[key, iv, 5];\nstate //MatrixForm *)\n\n\n\n(* WordMask[word] //MatrixForm\nPolynomialMod[matrixS + WordMask[wordS], 2]//MatrixForm\n\nsponge = SpongeAbsorption[state, word];\nsponge //MatrixForm\n\n(* CipherMask[sponge]*)\nDiffiusionLayer[matrixS] //MatrixForm \n\napp = CrossSpongeEncString[key, iv, 1, \"mamma\"];\n\nBitsToString[app] *)\n\n\ns = CrossSpongeWarmUp[key, iv, 1]\nSpongeAbsorption[s, \"a\"]\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n\nn = 4;\n\ns = Mod[Partition[Range[n*n], n], 2];\nStringToBits[str_String] := Flatten[IntegerDigits[ToCharacterCode[str], 2, 8]]\nw = StringToBits[\"a\"]\n\nr = s[[1]];\n{r[[1]], r[[3]]}\n\nr = s[[2]];\n{r[[2]], r[[4]]}\n\n\nStateMask[state_List] := Module[\n    {row1, row2, row3, row4},\n\n    row1 = state[[1]];\n    row2 = state[[2]];\n    row3 = state[[3]];\n    row4 = state[[4]];\n\n    newRow1 = {row1[[1]], 0, row1[[3]], 0};\n    newRow2 = {0,row2[[2]], 0, row2[[4]]};\n    newRow3 = {row3[[1]], 0, row3[[3]], 0};\n    newRow4 = {0, row4[[2]], 0, row4[[4]]};\n\n    {newRow1, newRow2, newRow3, newRow4}\n\n]\n\nWordMask[word_List] := Module[\n    {row1, row2, row3, row4},\n\n    row1 = {word[[1]], 0, word[[2]], 0};\n    row2 = {0, word[[3]], 0, word[[4]]};\n    row3 = {word[[5]], 0, word[[6]], 0};\n    row4 = {0, word[[7]], 0, word[[8]]};\n\n    {row1, row2, row3, row4}\n]\n\ns //MatrixForm\n\nSpongeAbsorption[state_List, word_List] := Mod[StateMask[state] + WordMask[word] + state, 2]\nSpongeAbsorption[s, word] //MatrixForm\n\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "w\n{w[[1]],\"-\",w[[2]],0}\n{\"-\",w[[3]],\"-\",w[[4]]}\nC = RandomInteger[{0,1}, 4]\nAffineConstant[half_Integer] := Array[Mod[#1 + #2, 2] &, {half, half}];\nAffineConstant[4]",
   "languageId": "wolfram",
