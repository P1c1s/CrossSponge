  {
   "kind": 2,
   "value": "Struct[key_List, iv_List] := Partition[Join[key, iv], Sqrt[Length[Join[key,iv]]]]\n\n(* fun2[state_List]:= Module[{a,b,c},\n    a = state[[1]]; b = state[[2]]; c = state[[3]];\n    {a*b+c,b*c,c*a+b}\n] *)\n\n(* substitutionLayer[state_List]:= Module[{a,b,c},\n    a = state[[1]]; b = state[[2]]; c = state[[3]];\n    Transpose[{a*b+c,b*c,c*a+b}]\n] *)\n\n(* substitutionLayer[state_List]:= Module[{half, end, qTL, qTR, qBL, qBR},\n    end = Length[s];\n    half = end / 2;\n\n    (* Quadrante 1: In alto a sinistra (Top-Left) *)\n    qTL = state[[1 ;; half, 1 ;; half]];\n\n    (* Quadrante 2: In alto a destra (Top-Right) *)\n    qTR = state[[1 ;; half, half + 1 ;; end]];\n\n    (* Quadrante 3: In basso a sinistra (Bottom-Left) *)\n    qBL = state[[half + 1 ;; end, 1 ;; half]];\n\n    (* Quadrante 4: In basso a destra (Bottom-Right) *)\n    qBR = state[[half + 1 ;; end, half + 1 ;; end]];\n    \n    Transpose[{Flatten[qTL + qBL], Flatten[qTR + qBR], Flatten[qTL * qBL], Flatten[qTR * qBR]}]\n] *)\n\nSubstitutionLayer[state_List]:= Module[{half, end, qTL, qTR, qBL, qBR},\n    end = Length[state];\n    half = end / 2;\n\n    (* Quadrante 1: In alto a sinistra (Top-Left) *)\n    qTL = state[[1 ;; half, 1 ;; half]];\n\n    (* Quadrante 2: In alto a destra (Top-Right) *)\n    qTR = state[[1 ;; half, half + 1 ;; end]];\n\n    (* Quadrante 3: In basso a sinistra (Bottom-Left) *)\n    qBL = state[[half + 1 ;; end, 1 ;; half]];\n\n    (* Quadrante 4: In basso a destra (Bottom-Right) *)\n    qBR = state[[half + 1 ;; end, half + 1 ;; end]];\n    \n    Transpose[{Flatten[Mod[qTL + qBR, 2]], Flatten[Mod[qTR + qBL, 2]], Flatten[Mod[qTL * qBR, 2]], Flatten[Mod[qTR * qBL, 2]]}]\n]\n\n\nSubstitutionLayer[state_List] := Module[\n  {len, half, qTL, qTR, qBL, qBR, nTL, nTR, nBL, nBR},\n  \n  len = Length[state];\n  half = len / 2;\n\n  (* 1. Estrazione dei 4 quadranti originali *)\n  qTL = state[[1 ;; half, 1 ;; half]];\n  qTR = state[[1 ;; half, half + 1 ;; len]];\n  qBL = state[[half + 1 ;; len, 1 ;; half]];\n  qBR = state[[half + 1 ;; len, half + 1 ;; len]];\n\n  (* 2. Calcolo dei nuovi quadranti con incrocio Feistel/Ascon *)\n  (* Ciascun quadrante viene aggiornato sommandogli il prodotto degli altri due *)\n  nTL = PolynomialMod[qTL + qTL * qBR, 2];\n  nTR = PolynomialMod[qTR + qTR * qBL, 2];\n  nBL = PolynomialMod[qBL + qBL * qTR, 2];  (* Usa nTL già aggiornato per diffondere subito *)\n  nBR = PolynomialMod[qBR + qBR * qTL, 2];  (* Usa nTR ed nBL aggiornati *)\n\n  (* 3. Ricostruzione della matrice quadrata N x N originale *)\n  ArrayFlatten[{{nTL, nTR}, {nBL, nBR}}]\n]\n\n\nDiffiusionLayer[state_List] := Module[\n    {row1, row2, row3, row4, len},\n    \n    row1 = state[[1]];\n    row2 = state[[2]];\n    row3 = state[[3]];\n    row4 = state[[4]];\n    len = Length[state];\n\n    {RotateLeft[row1, len / 2], \n     RotateLeft[row2, len / 2],\n     RotateLeft[row3, len / 2],\n     RotateLeft[row4, len / 2]\n    }\n];\n\n\nStateMask[state_List] := Module[\n    {row1, row2, row3, row4},\n\n    row1 = state[[1]];\n    row2 = state[[2]];\n    row3 = state[[3]];\n    row4 = state[[4]];\n\n    newRow1 = {row1[[1]], 0, row1[[3]], 0};\n    newRow2 = {0,row2[[2]], 0, row2[[4]]};\n    newRow3 = {row3[[1]], 0, row3[[3]], 0};\n    newRow4 = {0, row4[[2]], 0, row4[[4]]};\n\n    {newRow1, newRow2, newRow3, newRow4}\n\n];\n\nCipherMask[state_List] := {state[[1,1]], state[[1,3]], state[[2,2]], state[[2,4]], state[[3,1]], state[[3,3]], state[[4,2]], state[[4,4]]};\n\nWordMask[word_List] := Module[\n    {row1, row2, row3, row4},\n\n    row1 = {word[[1]], 0, word[[2]], 0};\n    row2 = {0, word[[3]], 0, word[[4]]};\n    row3 = {word[[5]], 0, word[[6]], 0};\n    row4 = {0, word[[7]], 0, word[[8]]};\n\n    {row1, row2, row3, row4}\n]\n\nSponge[state_List, word_List] := Mod[StateMask[state] + WordMask[word] + state, 2]\n\nCrossRound[state_List] := DiffiusionLayer[SubstitutionLayer[state]];\n\nCrossSpongeWarmUp[key_List, iv_List, nRound_Integer] := Nest[CrossRound[#] &, Struct[key, iv], nRound];\n\n\nCrossSpongeWarmUp[keys, ivs, 1] //MatrixForm\n(* CrossSpongeWarmUp[keys, ivs, 2] //MatrixForm\nCrossSpongeWarmUp[keys, ivs, 3] //MatrixForm *)\n\n(* \nCrossSpongeWarmUp[key, iv, 1] //MatrixForm\nCrossSpongeWarmUp[key, iv, 2] //MatrixForm\nCrossSpongeWarmUp[key, iv, 3] //MatrixForm\nCrossSpongeWarmUp[key, iv, 4] //MatrixForm\nCrossSpongeWarmUp[key, iv, 5] //MatrixForm\nCrossSpongeWarmUp[key, iv, 6] //MatrixForm\nCrossSpongeWarmUp[key, iv, 7] //MatrixForm *)\nstate = CrossSpongeWarmUp[key, iv, 8];\nstate //MatrixForm\n\nsponge = Sponge[state, word];\n\nsponge //MatrixForm\n\nCipherMask[sponge]\n\n\n",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wrow><w></w><wb>(</wb><w>⁠</w><wgrid style=\"grid-template-columns:repeat(4,max-content);\"><w><wrow><w></w><w>k3</w><w>+</w><wrow><w></w><w>k3</w><w></w><w>v1</w></wrow></wrow></w><w><wrow><w></w><w>k4</w><w>+</w><wrow><w></w><w>k4</w><w></w><w>v2</w></wrow></wrow></w><w><wrow><w></w><w>k1</w><w>+</w><wrow><w></w><w>k1</w><w></w><w>v3</w></wrow></wrow></w><w><wrow><w></w><w>k2</w><w>+</w><wrow><w></w><w>k2</w><w></w><w>v4</w></wrow></wrow></w><w><wrow><w></w><w>k7</w><w>+</w><wrow><w></w><w>k7</w><w></w><w>v5</w></wrow></wrow></w><w><wrow><w></w><w>k8</w><w>+</w><wrow><w></w><w>k8</w><w></w><w>v6</w></wrow></wrow></w><w><wrow><w></w><w>k5</w><w>+</w><wrow><w></w><w>k5</w><w></w><w>v7</w></wrow></wrow></w><w><wrow><w></w><w>k6</w><w>+</w><wrow><w></w><w>k6</w><w></w><w>v8</w></wrow></wrow></w><w><wrow><w></w><w>v3</w><w>+</w><wrow><w></w><w>k1</w><w></w><w>v3</w></wrow></wrow></w><w><wrow><w></w><w>v4</w><w>+</w><wrow><w></w><w>k2</w><w></w><w>v4</w></wrow></wrow></w><w><wrow><w></w><w>v1</w><w>+</w><wrow><w></w><w>k3</w><w></w><w>v1</w></wrow></wrow></w><w><wrow><w></w><w>v2</w><w>+</w><wrow><w></w><w>k4</w><w></w><w>v2</w></wrow></wrow></w><w><wrow><w></w><w>v7</w><w>+</w><wrow><w></w><w>k5</w><w></w><w>v7</w></wrow></wrow></w><w><wrow><w></w><w>v8</w><w>+</w><wrow><w></w><w>k6</w><w></w><w>v8</w></wrow></wrow></w><w><wrow><w></w><w>v5</w><w>+</w><wrow><w></w><w>k7</w><w></w><w>v5</w></wrow></wrow></w><w><wrow><w></w><w>v6</w><w>+</w><wrow><w></w><w>k8</w><w></w><w>v6</w></wrow></wrow></w></wgrid><w>⁠</w><wb>)</wb></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "MatrixForm[{{k3 + k3*v1, k4 + k4*v2, k1 + k1*v3, k2 + k2*v4}, {k7 + k7*v5, k8 + k8*v6, k5 + k5*v7, k6 + k6*v8}, {v3 + k1*v3, v4 + k2*v4, v1 + k3*v1, v2 + k4*v2}, {v7 + k5*v7, v8 + k6*v8, v5 + k7*v5, v6 + k8*v6}}]",
