  {
   "kind": 2,
   "value": "(* ClearAll[\"Global`*\"] *)\n\n(* === 1. UTILITIES E CONVERSIONI === *)\nRandomBits[n_Integer] := RandomInteger[{0, 1}, n];\n\nStruct[key_List, iv_List] := Partition[Join[key, iv], Sqrt[Length[Join[key, iv]]]];\n\nStringToBits[str_String] := Flatten[IntegerDigits[ToCharacterCode[str], 2, 8]];\n\nBitsToString[bits_List] := FromCharacterCode[FromDigits[#, 2] & /@ Partition[bits, 8]];\n\n(* === 2. MASCHERE === *)\nStateMask[state_List] := {\n  {state[[1, 1]], 0, state[[1, 3]], 0},\n  {0, state[[2, 2]], 0, state[[2, 4]]},\n  {state[[3, 1]], 0, state[[3, 3]], 0},\n  {0, state[[4, 2]], 0, state[[4, 4]]}\n};\n\nWordMask[word_List] := {\n  {word[[1]], 0, word[[2]], 0},\n  {0, word[[3]], 0, word[[4]]},\n  {word[[5]], 0, word[[6]], 0},\n  {0, word[[7]], 0, word[[8]]}\n};\n\nCipherMask[state_List] := {\n  state[[1, 1]], state[[1, 3]],\n  state[[2, 2]], state[[2, 4]],\n  state[[3, 1]], state[[3, 3]],\n  state[[4, 2]], state[[4, 4]]\n};\n\n(* === 3. STRATI DI PERMUTAZIONE === *)\nSubstitutionLayer[state_List] := Module[\n  {len = Length[state], half, qTL, qTR, qBL, qBR, nTL, nTR, nBL, nBR},\n  half = len / 2;\n\n  qTL = state[[1 ;; half, 1 ;; half]];\n  qTR = state[[1 ;; half, half + 1 ;; len]];\n  qBL = state[[half + 1 ;; len, 1 ;; half]];\n  qBR = state[[half + 1 ;; len, half + 1 ;; len]];\n\n  nTL = PolynomialMod[qTL + qTL * qBR, 2];\n  nTR = PolynomialMod[qTR + qTR * qBL, 2];\n  nBL = PolynomialMod[qBL + qBL * qTR, 2];\n  nBR = PolynomialMod[qBR + qBR * qTL, 2];\n\n  ArrayFlatten[{{nTL, nTR}, {nBL, nBR}}]\n];\n\nDiffiusionLayer[state_List] := Module[\n  {row1, row2, row3, row4, col1, col2, col3, col4, len = Length[state]},\n  {row1, row2, row3, row4} = state;\n\n  (* Rotazioni orizzontali *)\n  row1 = RotateLeft[row1, 1]; \n  row2 = RotateLeft[row2, 2];\n  row3 = RotateLeft[row3, 3];\n  row4 = RotateLeft[row4, 4];\n\n  (* Rotazioni verticali *)\n  {col1, col2, col3, col4} = Transpose[{row1, row2, row3, row4}];  \n  \n  (* FIX: Transpose finale per ripristinare la matrice 4x4 orizzontale *)\n  Transpose[{\n    RotateLeft[col1, len / 2], \n    RotateLeft[col2, len / 2],\n    RotateLeft[col3, len / 2],\n    RotateLeft[col4, len / 2]\n  }]\n];\n\nCrossRound[state_List] := DiffiusionLayer[SubstitutionLayer[state]];\n\n(* === 4. ARCHITETTURA SPONGE === *)\nSpongeAbsorption[state_List, word_List] := PolynomialMod[WordMask[word] + state, 2];\n\nCrossSpongeWarmUp[key_List, iv_List, nRound_Integer] := Nest[CrossRound, Struct[key, iv], nRound];\n\nCrossSpongeEnc[key_List, iv_List, nRound_Integer, word_List] := Module[\n  {initState, absorbedState, cipherBits, nextState},\n  initState = CrossSpongeWarmUp[key, iv, nRound];\n  absorbedState = SpongeAbsorption[initState, word];\n  cipherBits = CipherMask[absorbedState];\n  nextState = CrossRound[absorbedState];\n  cipherBits\n];\n\n(* === 5. VARSIMBOLI E VALORI CASUALI === *)\nkeyS = {k1, k2, k3, k4, k5, k6, k7, k8};\nivS  = {v1, v2, v3, v4, v5, v6, v7, v8};\n\nkey = RandomBits[Length[keyS]];\niv  = RandomBits[Length[ivS]];\n\nword = StringToBits[\"d\"];\nmatrixS = {{a, b, c, d}, {e, f, g, h}, {i, l, m, n}, {o, p, q, r}};\n\n(* === 6. ESECUZIONE TEST === *)\nPrint[\"--- Test DiffiusionLayer Simbolico ---\"]\nDiffiusionLayer[matrixS] // MatrixForm\n\nPrint[\"--- Test Cifratura (8 Bit) ---\"]\nbits = CrossSpongeEnc[key, iv, 1, StringToBits[\"a\"]]\nPrint[\"Lunghezza bit: \", Length[bits]]\n\nDiffiusionLayer[matrixS] //MatrixForm \n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n\nGet[\"/home/lorenzo/Documenti/GitHubProjects/CrossSponge/lib/funcs.wl\"]\nGet[\"/home/lorenzo/Documenti/GitHubProjects/CrossSponge/lib/cross-sponge.wl\"]\n\n(* Test con n = 4 *)\nkey4 = {1, 0, 1, 1, 0, 0, 1, 0};\niv4  = {0, 1, 1, 0, 1, 0, 0, 1};\n\nCrossSpongeWarmUp[key4, iv4, 12] //MatrixForm\nStringToBits[\"a\"]\ncifrato4 = CrossSpongeEncString[key4, iv4, 5, \"a\"]\nchiaro4  = CrossSpongeDecString[key4, iv4, 5, cifrato4]\n\n(* Test con n = 8 *)\nkey8 = RandomInteger[{0, 1}, 32];\niv8  = RandomInteger[{0, 1}, 32];\n\ncifrato8 = CrossSpongeEncString[key8, iv8, 5, \"Ciao\"]\nchiaro8  = CrossSpongeDecString[key8, iv8, 5, cifrato8]\nCrossSpongeWarmUp[key8, iv8, 12] //MatrixForm\n\n(* Converte una lista di bit in una stringa Esadecimale *)\nBitsToHex[bits_List] := StringJoin[\n  IntegerString[FromDigits[#, 2], 16, 1] & /@ Partition[bits, 4]\n];\n\n(* Funzione Inversa: Converte una stringa Esadecimale in lista di bit *)\nHexToBits[hex_String] := Flatten[\n  IntegerDigits[FromDigits[#, 16], 2, 4] & /@ Characters[hex]\n];\n\nBitsToHex[cifrato8]\nBitsToHex[StringToBits[chiaro8]]\n\n\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Get[\"/home/lorenzo/Documenti/GitHubProjects/CrossSponge/lib/funcs.wl\"]\nGet[\"/home/lorenzo/Documenti/GitHubProjects/CrossSponge/lib/cross-sponge.wl\"]\n\n(* Test con n = 4 *)\nkey4 = {1, 0, 1, 1, 0, 0, 1, 0};\niv4  = {0, 1, 1, 0, 1, 0, 0, 1};\n\n(* A partire da una lista di indici genera le varie combinazioni di grado dei maxterm *)\nGenerateMaxterms[indexes_List, degrees_List] := Flatten[Map[Subsets[indexes, {#}]&, degrees], 1]\n\n(* Restituisce num elementi a caso dalla mega lista di maxterm da un'insieme dato da tutte le combianzioni di deggress (esmepio {2,3} o {1}, ...)*)\nRandomMaxterms[ivLen_Integer, num_, degrees_List] := RandomSample[GenerateMaxterms[Range[16], degrees], num]\n\n\n(* Seleziona 'num' maxterm casuali dall'insieme dell'IV di lunghezza ivLen *)\nRandomMaxterms[ivLen_Integer, num_Integer, degrees_List] := Module[\n  {allMaxterms},\n  allMaxterms = GenerateMaxterms[Range[ivLen], degrees];\n  RandomSample[allMaxterms, Min[num, Length[allMaxterms]]]\n]\n\n(* Genera i cubi del nonce a partire da un maxterm specifico *)\nMakeCube[ivLen_Integer, maxterm_List] := Module[{d, zv},\n  d = Length[maxterm];\n  zv = Table[0, ivLen];\n  \n  Map[\n    Module[{ztmp = zv},\n      ztmp[[maxterm]] = IntegerDigits[#, 2, d];\n      ztmp\n    ] &, \n    Range[0, 2^d - 1]\n  ]\n]\n\niv = {1,0,1,1,0,0,1,1};\nkey = {1,0,1,1,1,1,1,0};\nivLen = Length[iv];\n\nmt = RandomMaxterms[ivLen, 1, {1}];\n(* MakeCube[4, {1,2,3}] *)\n\na = Flatten[Map[MakeCube[ivLen, #]&, mt],1];\n\nTotal[a];\n\nf[x_] := Mod[Total[x], 2];\n\nmt \nCrossSpongeWarmUp[key, iv, 1] //MatrixForm\n\nCubeOffline[maxterm_List, nRound_] := Module[\n  {keysUnit, zeroKey, cubeIv, alpha0, app},\n\n  keysUnit = IdentityMatrix[Length[key]];\n  zeroKey = ConstantArray[0, Length[key]];\n  cubeIv = MakeCube[Length[iv], maxterm[[1]]];\n  \n  alpha0 = f[CrossSpongeWarmUp[zeroKey, #, nRound] & /@ cubeIv];\n  app = f[f[Outer[CrossSpongeWarmUp[#1, #2, nRound] &, keysUnit, cubeIv, 1]]];\n\n  \n  (* Return *)\n  Mod[app + alpha0, 2]\n]\n\nCrossSpongeWarmUp[keyS, ivS, 1] //MatrixForm\n\n\nc = CubeOffline[mt, 1] //MatrixForm\nPosition[c, 1]\n\n(* \nf[CrossSpongeWarmUp[key, #, 1]& /@ a] + f[CrossSpongeWarmUp[key, ConstantArray[0, Length[iv]], 1]] //MatrixForm\nCrossSpongeWarmUp[ivS, keyS, 1] //MatrixForm *)",
   "languageId": "wolfram",
